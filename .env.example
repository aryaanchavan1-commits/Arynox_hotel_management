# Copy to .env and fill in values
VERCEL_TOKEN=
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=
GROQ_API_KEY=
ARYNOX_JWT_SECRET=
# Online payments (Razorpay) — set both for guest online payments; without these bookings stay "Unpaid" (pay-at-hotel)
# You can also set these in the CRM Admin -> Settings -> Payments (settings win over env).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PORT=5000
VITE_API_URL=http://localhost:5000

# Deploy modes
# SITE_MODE=public     -> website-only deployment (Vercel): booking, guest, payments, health. Staff/ERP APIs return 404.
# SITE_MODE=restaurant -> restaurant website deployment (Vercel): menu, table reservations, guest, payments.
# SITE_MODE=erp        -> full ERP deployment: everything.
# The client reads the mode from a server-rendered meta tag (layout.jsx) - no build-time env needed.