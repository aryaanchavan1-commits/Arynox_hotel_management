# Copy to .env and fill in values
VERCEL_TOKEN=
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=
GROQ_API_KEY=
ARYNOX_JWT_SECRET=
# Online payments (Razorpay) — set both for guest online payments; without these bookings stay "Unpaid" (pay-at-hotel)
# You can also set these in the CRM Admin -> Settings -> Payments (settings win over env).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PORT=5000
VITE_API_URL=http://localhost:5000

# Deploy modes
# SITE_MODE=public  -> website-only deployment (Vercel): booking, guest, payments, health. Staff/ERP APIs return 404.
# SITE_MODE=erp     -> full ERP deployment (Render): everything.
# NEXT_PUBLIC_SITE_MODE=public -> makes the client bundle website-only (hides staff UI, points ERP button to api_base_url).
NEXT_PUBLIC_SITE_MODE=